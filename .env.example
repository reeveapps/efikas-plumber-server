PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plumbers?schema=public"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_RESET_SECRET=""
COOKIE_DOMAIN=""
PARTNER_CLIENT_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3002"

# One-time secret gating POST /admin/setup-super-admin (bootstraps the first
# super admin). Leave unset in production once bootstrap is done.
SUPER_ADMIN_SETUP_SECRET=""

# Cloudflare R2 (S3-compatible object storage — KYC docs, booking photos, product images)
CF_ACCOUNT_ID=""
CF_ACCESS_KEY_ID=""
CF_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# M-Pesa Daraja (see src/utils/daraja-payments)
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL=""
DARAJA_ENVIRONMENT="sandbox"
DARAJA_INITIATOR_NAME=""
DARAJA_INITIATOR_PASSWORD=""
DARAJA_B2C_CERT=""
DARAJA_B2C_SHORTCODE=""
MPESA_CALLBACK_SECRET=""

BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@efikasplumber.com"
BREVO_SENDER_NAME="Efikas Plumber"

META_API_TOKEN=""
META_PHONE_NUMBER_ID=""

# TextSMS (sms.textsms.co.ke) — sends every SMS: OTP codes (see src/utils/phone-otp.ts)
# and notifications. TEXTSMS_SHORTCODE is your registered sender ID. Left empty outside
# production, messages are printed to the server console instead of sent.
TEXTSMS_API_KEY=""
TEXTSMS_PARTNER_ID=""
TEXTSMS_SHORTCODE=""

# Push notifications (Firebase Cloud Messaging) — stubbed until configured
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# OAuth sign-in — stubbed until configured
GOOGLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_CLIENT_ID=""
