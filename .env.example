PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plumbers?schema=public"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_RESET_SECRET=""
COOKIE_DOMAIN=""
CLIENT_URL="http://localhost:3000"

# One-time secret gating POST /admin/setup-super-admin (bootstraps the first
# super admin). Leave unset in production once bootstrap is done.
SUPER_ADMIN_SETUP_SECRET=""

# Cloudflare R2 (S3-compatible object storage — KYC docs, booking photos, product images)
CF_ACCOUNT_ID=""
CF_ACCESS_KEY_ID=""
CF_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# M-Pesa Daraja (see src/utils/daraja-payments)
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL=""
DARAJA_ENVIRONMENT="sandbox"
DARAJA_INITIATOR_NAME=""
DARAJA_INITIATOR_PASSWORD=""
DARAJA_B2C_CERT=""
DARAJA_B2C_SHORTCODE=""
MPESA_CALLBACK_SECRET=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="Plumbers <noreply@plumbers.app>"

META_API_TOKEN=""
META_PHONE_NUMBER_ID=""

AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME=""

# Twilio Verify — powers /auth/otp/request and /auth/otp/verify (see src/utils/twilio-otp.ts)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Push notifications (Firebase Cloud Messaging) — stubbed until configured
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# OAuth sign-in — stubbed until configured
GOOGLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_CLIENT_ID=""
